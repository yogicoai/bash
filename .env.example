# ── 로그인 ──
# 계정별 로그인 — "아이디:비밀번호" 를 쉼표로 구분.
# 비밀번호는 평문 또는 sha256:<hex> (npm run hash -- <비밀번호>)
# 계정 철회는 이 줄에서 빼면 끝. 비워두면 아래 DASH_PASSWORD 단일 모드로 동작.
DASH_USERS=yogico:비밀번호, design:sha256:해시값

DASH_PASSWORD=여기에_비밀번호
DASH_SESSION_SECRET=여기에_랜덤_64자_hex (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# ── 원천 API (브라우저에 노출되지 않음 — 서버사이드 프록시 전용) ──
REALTIME_API=https://port-0-realtime-lzgmwhc4d9883c97.sel4.cloudtype.app
OFFORDER_API=https://port-0-offorder-lzgmwhc4d9883c97.sel4.cloudtype.app

# ── 독립 앱(zone) 주소 — 팝업(iframe)으로 띄운다. 미설정 시 로컬 dev 기본값 사용 ──
NEXT_PUBLIC_ZONE_ONLINE=http://localhost:5200
NEXT_PUBLIC_ZONE_ADS=http://localhost:5810
NEXT_PUBLIC_ZONE_BLOG=http://localhost:5820
NEXT_PUBLIC_ZONE_B2B=http://localhost:5600
